namespace CallCalendar;

/** A stable public slug which is never reused after deletion. */
@pattern("^[a-z0-9]+(?:-[a-z0-9]+)*$")
@maxLength(100)
scalar CallTypeSlug extends string;

/** An opaque resource version. Clients must not interpret its contents. */
@minLength(1)
scalar ResourceVersion extends string;

/** A strong entity tag such as `\"7\"`. */
@pattern("^\"[1-9][0-9]*\"$")
scalar EntityTag extends string;

/** A UUID v4 generated by the public client for one normalized request. */
@format("uuid")
@pattern("^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$")
scalar IdempotencyKey extends string;

/** A canonical UUID v7 generated by the server. */
@format("uuid")
@pattern("^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$")
scalar ResourceId extends string;

/** A five-minute-grid RFC 3339 timestamp with an explicit offset and no fraction. */
@format("date-time")
@pattern("^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][05]:00(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$")
scalar RequestSlotDateTime extends string;

/** An RFC 3339 timestamp normalized to Europe/Moscow without fractional seconds. */
@format("date-time")
@pattern("^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\+03:00$")
scalar MoscowDateTime extends string;

/** A five-minute-grid RFC 3339 timestamp normalized to Europe/Moscow. */
@format("date-time")
@pattern("^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][05]:00\\+03:00$")
scalar MoscowSlotDateTime extends string;

/** Local Moscow time in `HH:mm` format. */
@pattern("^(?:[01][0-9]|2[0-3]):[0-5][05]$")
scalar LocalTime extends string;

@minLength(1)
@maxLength(80)
scalar CallTypeName extends string;

@maxLength(500)
scalar CallTypeDescription extends string;

/** Duration in minutes. The service accepts values in five-minute increments. */
@minValue(15)
@maxValue(240)
@TypeSpec.JsonSchema.multipleOf(5)
scalar DurationMinutes extends int32;

@minLength(1)
@maxLength(80)
scalar ScheduleName extends string;

@minLength(1)
@maxLength(100)
scalar VisitorName extends string;

@format("email")
@maxLength(254)
scalar VisitorEmail extends string;

@maxLength(1000)
scalar VisitorNotes extends string;

@maxLength(200)
scalar CallSearchQuery extends string;

@minLength(1)
scalar PageCursor extends string;

enum CallTypeStatus {
  Active: "active",
  Disabled: "disabled",
}

enum CallPeriod {
  Upcoming: "upcoming",
  Past: "past",
}

enum CallTypeDeleteBlockedReason {
  HasCalls: "call_type_has_calls",
}

enum ScheduleDeleteBlockedReason {
  InUse: "schedule_in_use",
  LastSchedule: "last_schedule",
}

model PublicCallTypeSummary {
  slug: CallTypeSlug;
  name: CallTypeName;
  description: CallTypeDescription | null;
  duration_minutes: DurationMinutes;
}

model PublicCallType extends PublicCallTypeSummary {
  status: CallTypeStatus;
  call_type_version: ResourceVersion;
}

model PublicCallTypeList {
  items: PublicCallTypeSummary[];
}

model AvailabilitySlot {
  starts_at: MoscowSlotDateTime;
  ends_at: MoscowSlotDateTime;
}

model AvailabilityDay {
  date: plainDate;
  slots: AvailabilitySlot[];
}

model AvailabilityResponseBody {
  generated_at: MoscowDateTime;
  timezone: "Europe/Moscow";
  call_type: PublicCallTypeSummary & {
    call_type_version: ResourceVersion;
  };

  @minItems(14)
  @maxItems(14)
  days: AvailabilityDay[];
}

model CreateCallRequest {
  call_type_slug: CallTypeSlug;
  call_type_version: ResourceVersion;
  starts_at: RequestSlotDateTime;
  visitor_name: VisitorName;
  visitor_email: VisitorEmail;
  visitor_notes?: VisitorNotes | null;
}

model CreatedCall {
  id: ResourceId;
  call_type_slug: CallTypeSlug;
  call_type_name: CallTypeName;
  duration_minutes: DurationMinutes;
  starts_at: MoscowSlotDateTime;
  ends_at: MoscowSlotDateTime;
  timezone: "Europe/Moscow";
  visitor_name: VisitorName;
  visitor_email: VisitorEmail;
  visitor_notes: VisitorNotes | null;
}

model WeeklyInterval {
  start_time: LocalTime;
  end_time: LocalTime;
}

model WeeklyDay {
  @minValue(1)
  @maxValue(7)
  day_of_week: int32;

  intervals: WeeklyInterval[];
}

model WeeklyDaysRequest {
  @minItems(7)
  @maxItems(7)
  days: WeeklyDay[];
}

model ScheduleReference {
  id: ResourceId;
  name: ScheduleName;
}

model AdminCallType {
  id: ResourceId;
  slug: CallTypeSlug;
  name: CallTypeName;
  description: CallTypeDescription | null;
  duration_minutes: DurationMinutes;
  status: CallTypeStatus;
  schedule: ScheduleReference;
  version: ResourceVersion;
  can_delete: boolean;
  delete_blocked_reason: CallTypeDeleteBlockedReason | null;
}

model AdminCallTypeList {
  items: AdminCallType[];
}

model CreateCallTypeRequest {
  name: CallTypeName;
  description?: CallTypeDescription | null;
  duration_minutes: DurationMinutes;
  schedule_id: ResourceId;
}

model UpdateCallTypeRequest {
  name: CallTypeName;
  description?: CallTypeDescription | null;
  duration_minutes: DurationMinutes;
  status: CallTypeStatus;
  schedule_id: ResourceId;
}

model AssignedCallType {
  id: ResourceId;
  name: CallTypeName;
  status: CallTypeStatus;
}

model AdminSchedule {
  id: ResourceId;
  name: ScheduleName;

  @minItems(7)
  @maxItems(7)
  days: WeeklyDay[];

  version: ResourceVersion;
  assigned_call_types: AssignedCallType[];
  can_delete: boolean;
  delete_blocked_reason: ScheduleDeleteBlockedReason | null;
}

model AdminScheduleList {
  items: AdminSchedule[];
}

model CreateScheduleRequest extends WeeklyDaysRequest {
  name: ScheduleName;
}

model UpdateScheduleRequest extends WeeklyDaysRequest {
  name: ScheduleName;
}

model WorkingHours {
  timezone: "Europe/Moscow";

  @minItems(7)
  @maxItems(7)
  days: WeeklyDay[];

  version: ResourceVersion;
}

model UpdateWorkingHoursRequest extends WeeklyDaysRequest {}

model AdminCall {
  id: ResourceId;
  call_type_id: ResourceId;
  call_type_name: CallTypeName;
  duration_minutes: DurationMinutes;
  starts_at: MoscowSlotDateTime;
  ends_at: MoscowSlotDateTime;
  visitor_name: VisitorName;
  visitor_email: VisitorEmail;
  visitor_notes: VisitorNotes | null;
}

model AdminCallPage {
  as_of: MoscowDateTime;
  timezone: "Europe/Moscow";

  @maxItems(50)
  items: AdminCall[];

  next_cursor: PageCursor | null;
}
